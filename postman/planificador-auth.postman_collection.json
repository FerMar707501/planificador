{
  "info": {
    "_postman_id": "5f490657-1d50-4bc6-9e23-2d2a5ab18c5f",
    "name": "Planificador - Autenticación",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "nombreUsuario",
      "value": ""
    },
    {
      "key": "correo",
      "value": ""
    },
    {
      "key": "contrasena",
      "value": "ClaveSegura123"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Registro",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const sufijo = Date.now();",
              "pm.collectionVariables.set('nombreUsuario', `usuario_${sufijo}`);",
              "pm.collectionVariables.set('correo', `usuario_${sufijo}@ejemplo.com`);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreUsuario\": \"{{nombreUsuario}}\",\n  \"correo\": \"{{correo}}\",\n  \"contrasena\": \"{{contrasena}}\",\n  \"nombreCompleto\": \"Usuario Postman\",\n  \"telefono\": \"55555555\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Inicio de sesión",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const respuesta = pm.response.json();",
              "if (respuesta.token) {",
              "  pm.collectionVariables.set('token', respuesta.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreUsuario\": \"{{nombreUsuario}}\",\n  \"contrasena\": \"{{contrasena}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Cambio de contraseña",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nuevaContrasena\": \"NuevaClave456\",\n  \"confirmarContrasena\": \"NuevaClave456\"\n}"
        },
        "url": "{{baseUrl}}/auth/change-password"
      }
    },
    {
      "name": "Recuperación de contraseña",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"{{correo}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/forgot-password"
      },
      "description": "Requiere configurar las variables SMTP en .env."
    },
    {
      "name": "Consultar perfil",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/users/me"
      }
    },
    {
      "name": "Actualizar perfil",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreCompleto\": \"Usuario Postman Actualizado\",\n  \"telefono\": \"55555556\"\n}"
        },
        "url": "{{baseUrl}}/users/me"
      }
    }
  ]
}
